# ============================================================
# WAN FACTORY PREMIX — Root .gitignore
# ============================================================

# ── Node / NPM ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/

# ── Build output ─────────────────────────────────────────────
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# ── Environment variables ────────────────────────────────────
.env
.env.local
.env.*.local
# .env.example sengaja di-track (template)

# ── Editor & OS ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── PHP / Laravel (backend nanti) ───────────────────────────
backend/vendor/
backend/storage/logs/
backend/.env
backend/public/hot
backend/public/storage
backend/.phpunit.result.cache
backend/bootstrap/cache/

# ── Misc ─────────────────────────────────────────────────────
*.local
*.bak
*.tmp
